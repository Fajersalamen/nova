{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-restaurant-saas",
  "main": ".open-next/worker.js",
  // Cloudflare's git-connected deploy only runs `npx wrangler versions
  // upload` — it never ran the actual Next.js/OpenNext build, so
  // `.open-next/worker.js` never existed and every deploy failed with
  // "entry-point file not found". This tells wrangler itself to build
  // first, regardless of what's configured (or not) in the dashboard.
  "build": {
    "command": "npm run cf:build"
  },
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backs the ISR/data cache. Create the bucket first:
  //   npx wrangler r2 bucket create nova-next-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "nova-next-cache"
    }
  ]

  // Secrets (Supabase keys, R2 credentials, REVALIDATE_SECRET) are NOT
  // stored here. Set them per environment in the Cloudflare dashboard, or
  // with: npx wrangler secret put <NAME>
}
