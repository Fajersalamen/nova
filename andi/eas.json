{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SUPABASE_URL": "@andi_supabase_url", "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@andi_supabase_anon_key" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_SUPABASE_URL": "@andi_supabase_url", "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@andi_supabase_anon_key" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_SUPABASE_URL": "@andi_supabase_url", "EXPO_PUBLIC_SUPABASE_ANON_KEY": "@andi_supabase_anon_key" }
    }
  },
  "submit": {
    "production": {}
  }
}
