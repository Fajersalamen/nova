# ==============================================================================
# Supabase — from your project's Settings > API page
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose to the browser. Used only in trusted server
# contexts (e.g. provisioning a new restaurant's first admin user).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================================
# Cloudflare R2 — object storage for menu images/videos
# Create a bucket + an R2 API token (Account > R2 > Manage API Tokens)
# ==============================================================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=nova-restaurant-media
# Public bucket URL (custom domain or r2.dev subdomain) used to render
# uploaded media on the public site.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.your-domain.com

# ==============================================================================
# Google Places API (optional) — only needed if a restaurant wants real
# Google reviews instead of the built-in review system. Leave unset to use
# the internal `reviews` table only.
# ==============================================================================
GOOGLE_PLACES_API_KEY=

# ==============================================================================
# Used by the admin dashboard to trigger on-demand revalidation of a
# restaurant's public page right after a menu edit. Generate any long
# random string; it must match between this app and itself (no external
# service needed) — it just prevents the endpoint from being called by
# random third parties.
# ==============================================================================
REVALIDATE_SECRET=generate-a-long-random-string
